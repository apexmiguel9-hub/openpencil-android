                        {
                          "type": "frame",
                          "id": "f173",
                          "name": "段落",
                          "width": "fill_container",
                          "height": "fit_content",
                          "layout": "vertical",
                          "gap": 18,
                          "fill": [],
                          "children": [
                            {
                              "type": "text",
                              "id": "t171",
                              "name": "正文",
                              "content": "闭环率停在 44%，不是因为没人整改，\n而是因为整改完成后没有一个必须回填的动作。\n没有回填，就没有记录；没有记录，复算就无从谈起。",
                              "fontFamily": "Noto Sans SC",
                              "fontSize": 30,
                              "fontWeight": 400,
                              "fill": [
                                {
                                  "type": "solid",
                                  "color": "$c-ink"
                                }
                              ],
                              "lineHeight": 1.8,
                              "letterSpacing": 0,
                              "textGrowth": "fixed-width",
                              "width": 900
                            }
                          ]
                        }
